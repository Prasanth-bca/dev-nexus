# Dev Nexus environment configuration.
#
# DOCKER USERS: You don't need this file! Docker Compose sets all required
# environment variables automatically. This file is only needed for local
# development without Docker.
#
# LOCAL DEVELOPMENT: Run `npm run setup` and it generates .env.local for you
# (copied from this template, with MongoDB and security keys filled in).
#
# This file (.env.example) is committed to the repo as a template and
# documentation of every variable Dev Nexus reads. .env.local is your own
# local copy — it's git-ignored and never committed.

# ---------------------------------------------------------------------------
# MongoDB (required)
# ---------------------------------------------------------------------------
# Docker Compose default: mongodb://mongodb:27017
# Local development default: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=dev_nexus

# ---------------------------------------------------------------------------
# Redis (optional — Gmail read cache)
# ---------------------------------------------------------------------------
# Docker Compose default: redis://redis:6379
# Local development default: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379
# How often the background sync job polls Gmail, in milliseconds. Defaults to 60000 (1 min).
# GMAIL_SYNC_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# Security keys (optional — auto-generated if left blank)
# ---------------------------------------------------------------------------
# `npm run setup` generates both of these for you with Node's crypto module.
# If you leave them blank, Dev Nexus auto-generates and persists them in
# MongoDB the first time it needs them (src/lib/kernel/instance-keys.ts) —
# either way, you never have to hand-generate or paste anything yourself.
# Set them here only if you want an explicit, portable value (e.g. so a
# mongodump/mongorestore migration to another machine keeps working without
# also needing to copy the instance_keys collection).
SECRET_MANAGER_KEY=
SESSION_SECRET=

# ---------------------------------------------------------------------------
# File Vault storage (optional)
# ---------------------------------------------------------------------------
# Where uploaded files are stored on disk. Defaults to var/file-vault under
# the project root if unset — only set this if you want uploads to live
# somewhere else (e.g. a separate data disk).
# FILE_VAULT_DIR=
